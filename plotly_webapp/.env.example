# Backend
BACKEND_BASE_URL=http://localhost:8000

# Authentication - OIDC (same app registration as the backend)
OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
OIDC_CLIENT_ID=<client-id>
OIDC_CLIENT_SECRET=your_client_secret
# The full scope URI, never 'openid profile'
OIDC_SCOPES=api://<client-id>/access_as_user
OIDC_REDIRECT_URI=http://localhost:8050/authorized
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8050/

# Sessions
SESSION_IDLE_TIMEOUT_SECONDS=28800
# Fernet key; rotating it signs everyone out
SESSION_ENCRYPTION_KEY=your_fernet_key
FLASK_SECRET_KEY=your_flask_secret_key
# Namespaces the session-cookie signature. Not a secret; changing it signs everyone out
SESSION_COOKIE_SALT=escala-session

# Database
DB_SCHEME=postgresql
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
