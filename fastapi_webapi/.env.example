# Database
DB_SCHEME=postgresql+asyncpg
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# Lakehouse Access
LAKEHOUSE_WORKSPACE_ID=your_fabric_workspace_id
LAKEHOUSE_ID=your_lakehouse_id
LAKEHOUSE_STORAGE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com
LAKEHOUSE_TABLES_PATH=abfss://your_fabric_workspace_id@onelake.dfs.fabric.microsoft.com/your_lakehouse_id/Tables/sap

# Blob Storage (Azure Blob, invoice document access)
BLOB_STORAGE_ACCOUNT_NAME=your_storage_account_name
BLOB_STORAGE_ENDPOINT=https://your_storage_account_name.blob.core.windows.net
BLOB_CONTAINER_NAME=your_container_name

#MLFLOW
MLFLOW_TRACKING_URI=http://127.0.0.1:5000 #if local

# Authentication - OIDC
OIDC_METADATA_URL=https://your-oidc-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=your_client_id
OIDC_AUDIENCE=your_audience
OIDC_SCOPES='openid profile'

# Authentication - Entra ID (App Registration used for both SQL and Lakehouse access)
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
# true -> use the AZURE_* app registration; false -> use the local `az login` session
AZURE_FLG_USE_APP_REGISTRATION=false

# Authentication - Microsoft Graph (always required)
GRAPH_TENANT_ID=your_graph_tenant_id
GRAPH_CLIENT_ID=your_graph_public_client_id
# If app registration with app permissions.
GRAPH_CLIENT_SECRET=your_graph_client_secret
GRAPH_MAILBOX=your_graph_mailbox@your_domain.com

# # AIRPY
# AIRPY_STAGE_USERNAME=your_airpy_username
# AIRPY_STAGE_PASSWORD=your_airpy_password

# # AWS S3 / Boto3
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# GENAI SECRETS - Google Vertex AI service account
GOOGLE_SA_TYPE=service_account
GOOGLE_SA_PROJECT_ID=your_gcp_project_id
GOOGLE_SA_PRIVATE_KEY_ID=your_private_key_id
# Key body only; BEGIN/END lines are added in code. Literal \n is fine.
GOOGLE_SA_PRIVATE_KEY=your_private_key_body
GOOGLE_SA_CLIENT_EMAIL=your_sa@your_gcp_project_id.iam.gserviceaccount.com
GOOGLE_SA_CLIENT_ID=your_sa_client_id
GOOGLE_SA_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SA_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SA_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SA_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your_sa
GOOGLE_SA_UNIVERSE_DOMAIN=googleapis.com
GOOGLE_LOCATION=global

LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16000
LLM_TIMEOUT=150
LLM_MAX_RETRIES=4