# Database
DB_SCHEME=postgresql+asyncpg
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# Lakehouse Access
LAKEHOUSE_WORKSPACE_ID=your_fabric_workspace_id
LAKEHOUSE_ID=your_lakehouse_id
LAKEHOUSE_STORAGE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com
LAKEHOUSE_TABLES_PATH=abfss://your_fabric_workspace_id@onelake.dfs.fabric.microsoft.com/your_lakehouse_id/Tables/sap

# Blob Storage (Azure Blob, invoice document access)
BLOB_STORAGE_ACCOUNT_NAME=your_storage_account_name
BLOB_STORAGE_ENDPOINT=https://your_storage_account_name.blob.core.windows.net
BLOB_CONTAINER_NAME=your_container_name

# Authentication - API Keys
HASHED_API_KEY=your_hashed_api_key_here

#MLFLOW
MLFLOW_TRACKING_URI=http://127.0.0.1:5000 #if local

# Authentication - OIDC
OIDC_METADATA_URL=https://your-oidc-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=your_client_id
OIDC_AUDIENCE=your_audience
OIDC_SCOPES='openid profile'

# Authentication - Entra ID (App Registration used for both SQL and Lakehouse access)
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
# true -> use the AZURE_* app registration; false -> use the local `az login` session
AZURE_FLG_USE_APP_REGISTRATION=false

# Authentication - Microsoft Graph (separate public client app registration,
# delegated permissions/device-code sign-in, no client secret)
GRAPH_TENANT_ID=your_graph_tenant_id
GRAPH_CLIENT_ID=your_graph_public_client_id

# # AIRPY
# AIRPY_STAGE_USERNAME=your_airpy_username
# AIRPY_STAGE_PASSWORD=your_airpy_password

# # AWS S3 / Boto3
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# GENAI SECRETS
OPENAI_API_KEY=your_litellm_api_key
OPENAI_MODEL=gpt-5-mini
EMBEDDINGS_MODEL="text-embedding-3-small"
OPENAI_API_BASE=https://litellm-dev.ltplabs.net/

LLM_TEMPERATUREfloat=0.0
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=150