{
  "folders": [
    {
      "name": "repo root",
      "path": "..",
    },
    {
      "name": "backend (fastapi_webapi)",
      "path": "../fastapi_webapi",
    },
    {
      "name": "frontend (plotly_webapp)",
      "path": "../plotly_webapp",
    },
  ],
  "settings": {
    "files.eol": "\n",
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "editor.formatOnSave": true,
    "biome.lsp.bin": "./react_webapp/node_modules/@biomejs/cli-win32-x64/biome.exe",
    "biome.configurationPath": "./react_webapp/biome.json",
    "cSpell.words": ["Topbar"],
    "tailwindCSS.classFunctions": ["cva"],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "always",
      },
    },
    "ruff.importStrategy": "fromEnvironment",
    "ruff.interpreter": ["${workspaceFolder}/.venv/Scripts/python.exe"],
    "ruff.configuration": "${workspaceFolder}/pyproject.toml",

    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": false,
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "biomejs.biome",
      "usernamehw.errorlens",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Backend: Debug",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:backend (fastapi_webapi)}/.venv/Scripts/python.exe",
        "debugAdapterPython": "${workspaceFolder:backend (fastapi_webapi)}/.venv/Scripts/python.exe",
        "debugLauncherPython": "${workspaceFolder:backend (fastapi_webapi)}/.venv/Scripts/python.exe",
        "module": "uvicorn",
        "args": [
          "api.main:app",
          "--port",
          "8000",
          "--reload",
          "--app-dir",
          "src",
        ],
        "cwd": "${workspaceFolder:backend (fastapi_webapi)}",
        "justMyCode": false,
        "preLaunchTask": "Backend: uv sync (silent)",
        "presentation": { "group": "2. backend", "order": 1 },
      },
      {
        "name": "Frontend: Debug",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:frontend (plotly_webapp)}/.venv/Scripts/python.exe",
        "debugAdapterPython": "${workspaceFolder:frontend (plotly_webapp)}/.venv/Scripts/python.exe",
        "debugLauncherPython": "${workspaceFolder:frontend (plotly_webapp)}/.venv/Scripts/python.exe",
        "program": "app.py",
        "cwd": "${workspaceFolder:frontend (plotly_webapp)}",
        "justMyCode": false,
        "preLaunchTask": "Frontend: uv sync (silent)",
        "presentation": { "group": "3. frontend", "order": 1 },
      },
      {
        "name": "Backend: Debug Test",
        "type": "debugpy",
        "request": "launch",
        "python": "${workspaceFolder:backend (fastapi_webapi)}/.venv/Scripts/python.exe",
        "program": "${file}",
        "purpose": ["debug-test"],
        "cwd": "${workspaceFolder:backend (fastapi_webapi)}",
        "envFile": "${workspaceFolder:backend (fastapi_webapi)}/.env",
        "console": "integratedTerminal",
        "justMyCode": false,
        // "preLaunchTask": "Backend: uv sync (silent)", // commenting this out because it breaks FE tests, uv sync must be run manually (for now)
        "presentation": { "hidden": true },
      },
    ],
    "compounds": [
      {
        "name": "Full Stack: Run",
        "configurations": ["Backend: Debug", "Frontend: Debug"],
        "presentation": { "group": "1. Full Stack", "order": 1 },
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Backend: uv sync (silent)",
        "options": {
          "cwd": "${workspaceFolder:backend (fastapi_webapi)}",
        },
        "command": "uv sync --group dev",
        "type": "shell",
        "problemMatcher": ["$python"],
        "runOptions": { "runOn": "folderOpen" },
        "presentation": {
          "reveal": "never",
          "close": true,
        },
        "group": "build",
      },
      {
        "label": "Frontend: uv sync (silent)",
        "options": {
          "cwd": "${workspaceFolder:frontend (plotly_webapp)}",
        },
        "command": "uv sync",
        "type": "shell",
        "problemMatcher": ["$python"],
        "runOptions": { "runOn": "folderOpen" },
        "presentation": {
          "reveal": "never",
          "close": true,
        },
        "group": "build",
      },
    ],
  },
}
